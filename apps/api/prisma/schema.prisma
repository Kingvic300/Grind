generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Status {
  INTERESTED
  REGISTERED
  BUILDING
  SUBMITTED
  DONE
}

enum Format {
  ONLINE
  IN_PERSON
  HYBRID
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String
  name           String
  emailReminders Boolean       @default(true)
  createdAt      DateTime      @default(now())
  hackathons     Hackathon[]
  edited         Hackathon[]   @relation("HackathonEditor")
  memberships    SpaceMember[]
}

enum SpaceRole {
  OWNER
  MEMBER
}

// A shared hackathon list. Members join through the invite link and can all edit.
model Space {
  id         String        @id @default(cuid())
  name       String
  inviteCode String        @unique
  createdAt  DateTime      @default(now())
  members    SpaceMember[]
  hackathons Hackathon[]
}

model SpaceMember {
  spaceId  String
  space    Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     SpaceRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@id([spaceId, userId])
  @@index([userId])
}

model Hackathon {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Null for the user's private list. Set for a hackathon in a shared list.
  spaceId     String?
  space       Space?  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  updatedById String?
  updatedBy   User?   @relation("HackathonEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  // Basics
  name      String
  organizer String?
  url       String?
  format    Format    @default(ONLINE)
  location  String?
  startDate DateTime?
  endDate   DateTime?

  // Status and deadlines
  status               Status    @default(INTERESTED)
  position             Float     @default(0)
  registrationDeadline DateTime?
  submissionDeadline   DateTime?

  // Project and team
  projectName        String?
  projectDescription String?
  techStack          String[]
  teammates          String[]
  repoUrl            String?
  demoUrl            String?

  // Results
  won         Boolean @default(false)
  placement   String?
  prizeName   String?
  prizeAmount Int?
  notes       String?

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  reminders ReminderLog[]

  @@index([userId, status])
  @@index([spaceId])
}

// One row per reminder email sent, so a reminder is never sent twice.
model ReminderLog {
  id          String    @id @default(cuid())
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  kind        String
  sentAt      DateTime  @default(now())

  @@unique([hackathonId, kind])
}
