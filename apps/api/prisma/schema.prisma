generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Status {
  INTERESTED
  REGISTERED
  BUILDING
  SUBMITTED
  DONE
}

enum Format {
  ONLINE
  IN_PERSON
  HYBRID
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  emailReminders Boolean  @default(true)
  createdAt      DateTime @default(now())

  // Raised on password change or "sign out other devices". Sessions with an older value stop working.
  tokenVersion Int @default(0)

  // Profile. avatarUrl holds a small resized image as a data: URL, so no file storage is needed.
  avatarUrl   String?
  avatarColor String?
  bio         String?
  githubUrl   String?
  linkedinUrl String?
  websiteUrl  String?
  xUrl        String?
  skills      String[] @default([])

  // Which reminder emails to send. emailReminders is the master switch.
  remindSubmission3d   Boolean   @default(true)
  remindSubmission1d   Boolean   @default(true)
  remindRegistration1d Boolean   @default(true)
  weeklyDigest         Boolean   @default(false)
  lastDigestAt         DateTime?

  // Discover interests: pre-filter Discover and pick matches for the digest.
  interestKind   String   @default("any")
  interestTopics String[] @default([])
  interestStack  String[] @default([])
  interestFormat String?

  // App preferences.
  defaultSpaceId String?
  weekStart      String  @default("MON")
  timeFormat     String  @default("auto")

  // Secret for the private calendar feed (.ics). Null when the feed is off.
  calendarToken String?       @unique
  hackathons    Hackathon[]
  edited        Hackathon[]   @relation("HackathonEditor")
  memberships   SpaceMember[]
  assignments   HackathonAssignee[]
  tasks         Task[]              @relation("TaskAssignee")
  comments      Comment[]           @relation("CommentAuthor")
  activity      Activity[]          @relation("ActivityActor")
}

enum SpaceRole {
  OWNER
  MEMBER
}

// A shared hackathon list. Members join through the invite link and can all edit.
model Space {
  id         String        @id @default(cuid())
  name       String
  inviteCode String        @unique
  createdAt  DateTime      @default(now())
  members    SpaceMember[]
  hackathons Hackathon[]
  activity   Activity[]
}

model SpaceMember {
  spaceId  String
  space    Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     SpaceRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@id([spaceId, userId])
  @@index([userId])
}

model Hackathon {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Null for the user's private list. Set for a hackathon in a shared list.
  spaceId     String?
  space       Space?  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  updatedById String?
  updatedBy   User?   @relation("HackathonEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  // Basics
  name      String
  organizer String?
  url       String?
  format    Format    @default(ONLINE)
  location  String?
  startDate DateTime?
  endDate   DateTime?

  // Status and deadlines
  status               Status    @default(INTERESTED)
  position             Float     @default(0)
  registrationDeadline DateTime?
  submissionDeadline   DateTime?

  // Project and team
  projectName        String?
  projectDescription String?
  techStack          String[]
  teammates          String[]
  repoUrl            String?
  demoUrl            String?

  // Results
  won         Boolean @default(false)
  placement   String?
  prizeName   String?
  prizeAmount Int?
  notes       String?

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  reminders ReminderLog[]
  assignees HackathonAssignee[]
  tasks     Task[]
  comments  Comment[]
  activity  Activity[]

  @@index([userId, status])
  @@index([spaceId])
}

// One row per reminder email sent, so a reminder is never sent twice.
model ReminderLog {
  id          String    @id @default(cuid())
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  kind        String
  sentAt      DateTime  @default(now())

  @@unique([hackathonId, kind])
}

// Team members responsible for a hackathon.
model HackathonAssignee {
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([hackathonId, userId])
  @@index([userId])
}

// A checklist item inside a hackathon, such as "record demo video".
model Task {
  id          String    @id @default(cuid())
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  title       String
  done        Boolean   @default(false)
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  position    Float     @default(0)
  createdAt   DateTime  @default(now())

  @@index([hackathonId])
}

model Comment {
  id          String    @id @default(cuid())
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  // Null when the author deleted their account.
  authorId    String?
  author      User?     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body        String
  createdAt   DateTime  @default(now())

  @@index([hackathonId, createdAt])
}

// Team activity feed: who did what. hackathonName is kept so entries survive a delete.
model Activity {
  id            String     @id @default(cuid())
  spaceId       String
  space         Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  actorId       String?
  actor         User?      @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  hackathonId   String?
  hackathon     Hackathon? @relation(fields: [hackathonId], references: [id], onDelete: SetNull)
  hackathonName String?
  kind          String
  detail        String?
  createdAt     DateTime   @default(now())

  @@index([spaceId, createdAt])
}
