# Neon: use the pooled URL here and the direct URL (host without "-pooler") below.
# Local Docker: use postgresql://grind:grind@localhost:5432/grind for both.
DATABASE_URL="postgresql://grind:grind@localhost:5432/grind?schema=public"
DIRECT_URL="postgresql://grind:grind@localhost:5432/grind?schema=public"
# Generate with: openssl rand -hex 32
JWT_SECRET="change-me"
PORT=3000
WEB_ORIGIN="http://localhost:5173"
# Link used in reminder emails
APP_URL="http://localhost:5173"
# Brevo transactional email. When set, reminders go through Brevo instead of SMTP.
# MAIL_FROM must be a sender verified in your Brevo account.
BREVO_API_KEY=""
# SMTP fallback. The defaults point at Mailpit from docker-compose.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Grind <reminders@grind.local>"

# Optional. Brave Search API key (https://brave.com/search/api/). Turns on LinkedIn events in Discover.
BRAVE_SEARCH_API_KEY=""
